<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.wannian</groupId>
    <artifactId>wn-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>wn-server</name>
    <description>万年烟火单节点内核</description>

    <modules>
        <module>api</module>
        <module>kernel</module>
        <module>../wannian-ui</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- 与 products/han-server 对齐；Boot BOM 不管 sqlite-jdbc -->
        <sqlite-jdbc.version>3.47.2.0</sqlite-jdbc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.wannian</groupId>
                <artifactId>wn-server-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wannian</groupId>
                <artifactId>wn-server-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wannian</groupId>
                <artifactId>wannian-ui</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!--
              ArchUnit JUnit5：仅用于测试期依赖门禁（ModuleDependencyRulesTest）。
              扫描已编译类的包引用，阻止 api→kernel/app、kernel→app/Spring Web 等反向依赖。
              版本在此统一管理；真正引入在 app 模块，且必须是 test scope，不进运行时 jar。
            -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!--
              K02 1B-0：SQLite JDBC。仅允许 app 引入；api/kernel 门禁测试会拦截。
              Flyway：SQLite 由 flyway-core 内建支持，无需额外 database 模块（Boot BOM 管版本）。
            -->
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>
</project>
